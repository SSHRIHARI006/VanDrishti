# Google Cloud project registered for Earth Engine (required).
# Authenticate once on the machine with:  earthengine authenticate
GEE_PROJECT=your-gee-project-id

# Where jobs and cached rasters are stored (default: ./data)
# VANDRISHTI_DATA_DIR=./data

# Largest boundary accepted per run, and the size that triggers a warning (km²)
# VANDRISHTI_MAX_AOI_KM2=10
# VANDRISHTI_WARN_AOI_KM2=5

# Max boundary upload size (MB)
# VANDRISHTI_MAX_UPLOAD_MB=20

# Allowed browser origins for the API (comma-separated)
# VANDRISHTI_CORS_ORIGINS=http://localhost:5173

# Sign-in (optional). Setting an admin password switches sign-in on for the whole app;
# the admin then adds other users from the Users page.
# VANDRISHTI_ADMIN_USER=admin
# VANDRISHTI_ADMIN_PASSWORD=
# Keeps people signed in across restarts (any long random text)
# VANDRISHTI_SECRET_KEY=
# Private Hugging Face dataset that keeps the user list across restarts of a hosted copy,
# and a token that can write to it
# VANDRISHTI_USERS_REPO=
# VANDRISHTI_USERS_TOKEN=
